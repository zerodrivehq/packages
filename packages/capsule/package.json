{
  "name": "@zerodrivehq/capsule",
  "version": "0.2.0",
  "description": "Portable encrypted containers and ZeroDrive compatibility primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodrivehq/packages.git",
    "directory": "packages/capsule"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/capsule-v1.test.ts test/legacy-shared.test.ts test/personal-file.test.ts test/private-key-backup.test.ts",
    "test:browser": "pnpm build && node --test test/browser-compat.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@scure/bip39": "^2.2.0"
  }
}
