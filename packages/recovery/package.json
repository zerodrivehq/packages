{
  "name": "@zerodrivehq/recovery",
  "version": "0.2.1",
  "description": "Offline recovery CLI for ZeroDrive personal files",
  "type": "module",
  "bin": {
    "zerodrive-recovery": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodrivehq/packages.git",
    "directory": "packages/recovery"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @zerodrivehq/capsule build && pnpm build && node --test test/*.test.ts",
    "typecheck": "pnpm --filter @zerodrivehq/capsule build && tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@zerodrivehq/capsule": "^0.2.0"
  }
}
